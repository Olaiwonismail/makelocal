# Copy to .env for local runs, or set these in your environment.
# Only GEMINI_API_KEY is required for live analysis; each other key switches on one data source.
GEMINI_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EXCHANGERATE_API_KEY=
API_NINJAS_KEY=

# Optional
MAKELOCAL_MODEL=gemma-4-31b-it
MAKELOCAL_DB=makelocal.db
